/**app.wxss — OV Watch 极简白色主题 */

page {
  --bg: #f5f7fa;
  --surface: #ffffff;
  --border: #eceef2;
  --border-strong: #d8dce3;
  --text: #1a1d23;
  --text-dim: #6b7280;
  --text-mute: #9ca3af;
  --primary: #2563eb;
  --primary-light: #eff4ff;
  --primary-bg: #dbeafe;
  --green: #16a34a;
  --green-bg: #dcfce7;
  --amber: #d97706;
  --amber-bg: #fef3c7;
  --red: #dc2626;
  --red-bg: #fee2e2;
  --shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: var(--text);
  min-height: 100vh;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
}

/* ============== 卡片 ============== */
.card {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

/* ============== 英雄连接区 ============== */
.hero-card {
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 32rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 1rpx;
}

.hero-subtitle {
  font-size: 22rpx;
  color: var(--text-mute);
  margin-top: 4rpx;
}

/* 脉冲环 */
.pulse-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 12rpx 0 28rpx;
}

.pulse-ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 2rpx solid var(--primary);
  opacity: 0.4;
  animation: pulse 2.4s ease-out infinite;
}

.pulse-ring-2 { animation-delay: 0.8s; }
.pulse-ring-3 { animation-delay: 1.6s; }

@keyframes pulse {
  0% { transform: scale(0.7); opacity: 0.5; }
  100% { transform: scale(1.3); opacity: 0; }
}

.pulse-core {
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: var(--primary-light);
  border: 3rpx solid var(--primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
  box-shadow: 0 0 30rpx rgba(37, 99, 235, 0.15);
}

.pulse-core.connected {
  border-color: var(--green);
  background: var(--green-bg);
  box-shadow: 0 0 30rpx rgba(22, 163, 74, 0.15);
}

.pulse-core.scanning {
  border-color: var(--amber);
  background: var(--amber-bg);
  box-shadow: 0 0 30rpx rgba(217, 119, 6, 0.15);
}

.pulse-core.disconnected {
  border-color: var(--border-strong);
  background: #f9fafb;
  box-shadow: none;
}

.pulse-icon {
  font-size: 48rpx;
}

.pulse-label {
  font-size: 18rpx;
  color: var(--text-mute);
  letter-spacing: 2rpx;
  margin-top: 2rpx;
}

.pulse-value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
  letter-spacing: 1rpx;
  margin-top: 2rpx;
}

.pulse-core.connected .pulse-value { color: var(--green); }
.pulse-core.scanning .pulse-value { color: var(--amber); }
.pulse-core.disconnected .pulse-value { color: var(--text-mute); }

/* ============== 状态徽章 ============== */
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 100rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: 1rpx solid;
}

.status-badge::before {
  content: "";
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
  animation: blink 1.6s ease-in-out infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.3; }
}

.status-ok {
  background: var(--green-bg);
  color: var(--green);
  border-color: rgba(22, 163, 74, 0.3);
}

.status-warn {
  background: var(--amber-bg);
  color: var(--amber);
  border-color: rgba(217, 119, 6, 0.3);
}

.status-err {
  background: var(--red-bg);
  color: var(--red);
  border-color: rgba(220, 38, 38, 0.3);
}

.status-info {
  background: var(--primary-bg);
  color: var(--primary);
  border-color: rgba(37, 99, 235, 0.3);
}

/* ============== 设备信息 ============== */
.device-meta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx 24rpx;
  width: 100%;
  margin-top: 8rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.meta-label {
  font-size: 22rpx;
  color: var(--text-mute);
  letter-spacing: 1rpx;
}

.meta-value {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 600;
  word-break: break-all;
  font-variant-numeric: tabular-nums;
}

.meta-value.rssi-good { color: var(--green); }
.meta-value.rssi-mid { color: var(--amber); }
.meta-value.rssi-weak { color: var(--red); }

/* ============== 卡片标题 ============== */
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-title::before {
  content: "";
  display: inline-block;
  width: 6rpx;
  height: 30rpx;
  background: var(--primary);
  border-radius: 3rpx;
}

/* ============== 按钮系统 ============== */
.btn-primary,
.btn-secondary,
.btn-danger,
.btn-ghost {
  width: 100% !important;
  box-sizing: border-box !important;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 16rpx !important;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
  height: 96rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  margin-left: 0 !important;
  margin-right: 0 !important;
  border: none;
}

.btn-primary::after,
.btn-secondary::after,
.btn-danger::after,
.btn-ghost::after {
  border: none !important;
  content: none !important;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(37, 99, 235, 0.3);
}

.btn-secondary {
  background: var(--primary-light);
  color: var(--primary);
  border: 2rpx solid var(--primary-bg) !important;
}

.btn-danger {
  background: var(--red);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(220, 38, 38, 0.25);
}

.btn-ghost {
  background: transparent;
  color: var(--text-dim);
  border: 2rpx solid var(--border-strong) !important;
}

/* 大按钮变体 — 用于英雄区和主要操作 */
.btn-tall {
  height: 104rpx;
  line-height: 104rpx;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.btn-primary[disabled],
.btn-secondary[disabled],
.btn-danger[disabled],
.btn-ghost[disabled] {
  background: #f3f4f6 !important;
  color: var(--text-mute) !important;
  border-color: var(--border) !important;
  box-shadow: none !important;
}

/* ============== 网格 ============== */
.grid-2 {
  display: flex;
  gap: 20rpx;
}

.grid-2 > button,
.grid-2 > view {
  flex: 1;
  min-width: 0;
}

/* ============== 信息行 ============== */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  color: var(--text-dim);
  font-size: 28rpx;
  flex-shrink: 0;
}

.row-value {
  color: var(--text);
  font-size: 28rpx;
  font-weight: 600;
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
  word-break: break-all;
  font-variant-numeric: tabular-nums;
}

/* ============== 传感器网格 ============== */
.sensor-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 8rpx;
}

.sensor-tile {
  background: #f9fafb;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  position: relative;
  overflow: hidden;
}

.sensor-tile::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: var(--primary);
  border-radius: 0 3rpx 3rpx 0;
}

.sensor-tile.accent-magenta::before { background: #ec4899; }
.sensor-tile.accent-amber::before { background: var(--amber); }
.sensor-tile.accent-green::before { background: var(--green); }
.sensor-tile.accent-red::before { background: var(--red); }

.sensor-icon {
  font-size: 32rpx;
  margin-bottom: 6rpx;
  display: block;
}

.sensor-name {
  font-size: 22rpx;
  color: var(--text-mute);
  margin-bottom: 6rpx;
}

.sensor-val {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
}

/* ============== 设备列表 ============== */
.device-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 20rpx;
  background: #f9fafb;
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
  margin: 12rpx 0;
  transition: all 0.2s ease;
  position: relative;
}

.device-item-hover {
  background: var(--primary-light);
  border-color: var(--primary-bg);
  transform: scale(0.99);
}

.device-item-last {
  background: var(--green-bg);
  border-color: rgba(22, 163, 74, 0.25);
}

.device-item-last::after {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 60%;
  background: var(--green);
  border-radius: 0 3rpx 3rpx 0;
}

.device-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.device-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 340rpx;
  display: inline-block;
}

.last-badge {
  font-size: 20rpx;
  color: var(--green);
  background: var(--green-bg);
  border: 1rpx solid rgba(22, 163, 74, 0.3);
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
  flex-shrink: 0;
}

.device-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-mute);
  word-break: break-all;
  font-family: "JetBrains Mono", Consolas, monospace;
}

.rssi-box {
  min-width: 160rpx;
  text-align: right;
  flex-shrink: 0;
}

.rssi-val {
  font-size: 22rpx;
  color: var(--text-dim);
  font-variant-numeric: tabular-nums;
  font-family: "JetBrains Mono", Consolas, monospace;
}

.rssi-bar-wrap {
  margin-top: 8rpx;
  width: 120rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--border);
  overflow: hidden;
  margin-left: auto;
}

.rssi-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--red), var(--amber) 50%, var(--green));
  border-radius: 4rpx;
}

/* ============== 日志 ============== */
.log-box {
  background: #1e293b;
  border-radius: 16rpx;
  padding: 24rpx;
  max-height: 480rpx;
  overflow-y: auto;
  font-family: "JetBrains Mono", Consolas, monospace;
  font-size: 22rpx;
  line-height: 1.7;
  color: #94a3b8;
}

.log-tx { color: #60a5fa; }
.log-rx { color: #fbbf24; }
.log-err { color: #f87171; }
.log-info { color: #94a3b8; }
.log-ok { color: #34d399; }

/* ============== 分隔线 ============== */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 28rpx 0;
}

/* ============== 滑块 ============== */
.slider-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--text-dim);
}

.slider-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
}

/* ============== 扫描指示器 ============== */
.scan-indicator {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: var(--amber);
  margin-left: auto;
}

.scan-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--amber);
  animation: blink 1s ease-in-out infinite;
}

/* ============== 通用 ============== */
.center-text {
  text-align: center;
  color: var(--text-dim);
}

.error-text {
  color: var(--red);
  font-size: 24rpx;
  line-height: 1.6;
}

/* ============== OTA / BootLoader 卡 ============== */
.ota-card { border: 2rpx dashed #cbd5e1; }

/* 步骤时间轴 */
.ota-steps {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0 4rpx;
  gap: 4rpx;
  flex-wrap: nowrap;
}
.ota-step {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 10rpx 6rpx;
  border-radius: 12rpx;
  background: #f3f4f6;
  color: var(--text-mute);
  font-size: 20rpx;
  font-weight: 600;
  border: 1rpx solid var(--border);
  letter-spacing: 0;
}
.ota-step text { white-space: nowrap; }
.ota-step.step-pass {
  background: var(--green-bg);
  border-color: rgba(22,163,74,0.3);
  color: var(--green);
}
.ota-step.step-now {
  background: var(--primary-bg);
  border-color: rgba(37,99,235,0.4);
  color: var(--primary);
  box-shadow: 0 0 0 3rpx rgba(37,99,235,0.12);
}
.ota-step.step-done {
  background: var(--green-bg);
  border-color: var(--green);
  color: var(--green);
}
.ota-step-arr {
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 10rpx solid #cbd5e1;
  flex-shrink: 0;
}

/* BootLoader 快捷按键行 */
.ota-key-row {
  display: flex;
  gap: 12rpx;
  align-items: stretch;
}
.ota-key {
  flex: 1;
  min-width: 0;
  height: 104rpx;
  line-height: 104rpx !important;
  font-size: 28rpx !important;
  letter-spacing: 0 !important;
}

/* 固件文件元数据 */
.fw-meta {
  margin-top: 16rpx;
  background: #f9fafb;
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
}
.fw-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 0;
  gap: 12rpx;
}
.fw-meta-label {
  color: var(--text-mute);
  font-size: 22rpx;
  flex-shrink: 0;
}
.fw-meta-value {
  color: var(--text);
  font-size: 24rpx;
  font-weight: 600;
  word-break: break-all;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* OTA 进度条 */
.ota-progress-bar {
  width: 100%;
  height: 24rpx;
  background: #eceef2;
  border-radius: 100rpx;
  overflow: hidden;
}
.ota-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2563eb, #60a5fa 60%, #34d399);
  border-radius: 100rpx;
  transition: width 0.3s ease;
  box-shadow: 0 2rpx 6rpx rgba(37, 99, 235, 0.25);
}

/* OTA 日志 */
.ota-log-box {
  background: #0f172a;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  max-height: 520rpx;
  overflow-y: auto;
  font-family: "JetBrains Mono", Consolas, monospace;
  font-size: 22rpx;
  line-height: 1.8;
  color: #cbd5e1;
}
.ota-log-line {
  white-space: pre-wrap;
  word-break: break-all;
  color: #cbd5e1;
}

/* OTA 提示行 */
.ota-hint {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  background: #fef3c7;
  border: 1rpx solid rgba(217, 119, 6, 0.25);
  border-radius: 10rpx;
  color: #92400e;
  font-size: 22rpx;
  line-height: 1.6;
}
.ota-hint-ok {
  background: var(--green-bg);
  border-color: rgba(22, 163, 74, 0.25);
  color: var(--green);
}
