/* pages/profile/profile.wxss — OV Watch 个人中心 */

.container {
  padding: 24rpx 32rpx 120rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============== 用户信息卡片 ============== */
.user-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
}

.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
}

.user-id {
  font-size: 26rpx;
  color: var(--text-mute);
}

/* ============== 通用卡片 ============== */
.card {
  background: var(--surface);
  border-radius: 32rpx;
  padding: 16rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin: 16rpx 0 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--primary);
}

/* ============== 设备信息行 ============== */
.device-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
}

.device-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.device-icon {
  font-size: 48rpx;
}

.device-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.device-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.device-status {
  font-size: 26rpx;
}

.status-connected { color: var(--green); }
.status-disconnected { color: var(--text-mute); }

.arrow {
  font-size: 32rpx;
  color: var(--text-mute);
}

/* ============== 设置项 ============== */
.setting-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-icon {
  font-size: 40rpx;
  width: 48rpx;
  text-align: center;
}

.setting-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
}

.setting-value {
  font-size: 28rpx;
  color: var(--text-mute);
  margin-right: 8rpx;
}

.setting-arrow {
  font-size: 28rpx;
  color: var(--text-mute);
}

/* ============== 版本信息 ============== */
.version-info {
  text-align: center;
  padding: 48rpx 0 24rpx;
  color: var(--text-mute);
  font-size: 26rpx;
}

.version-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.7;
}
