/* pages/dev/dev.wxss — OV Watch 开发者控制面板 */

.container {
  padding: 24rpx 32rpx 120rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============== 头部 ============== */
.dev-header {
  text-align: center;
  padding: 32rpx 0;
  margin-bottom: 32rpx;
}

.dev-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
}

.dev-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--amber);
}

/* ============== 通用卡片 ============== */
.card {
  background: var(--surface);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--primary);
}

/* ============== 状态行 ============== */
.status-row, .info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.status-row {
  border-bottom: 1rpx solid var(--border);
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
}

.status-text.connected { color: var(--green); font-weight: 600; }
.status-text.disconnected { color: var(--text-mute); }

.mono {
  font-family: monospace;
  font-size: 24rpx;
  color: var(--text-dim);
}

/* ============== 按钮 ============== */
button {
  margin: 16rpx 0 !important;
  border-radius: 16rpx !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
}

.btn-primary {
  background: var(--primary) !important;
  color: #fff !important;
}

.btn-secondary {
  background: var(--primary-light) !important;
  color: var(--primary) !important;
  border: 2rpx solid var(--primary-bg) !important;
}

.btn-ghost {
  background: transparent !important;
  color: var(--text-dim) !important;
  border: 2rpx solid var(--border-strong) !important;
}

.btn-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.btn-grid button {
  margin: 0 !important;
}

/* ============== 设备列表 ============== */
.device-list {
  margin-top: 16rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.device-item-hover {
  background: var(--primary-bg);
  transform: scale(0.98);
}

.device-item.is-last {
  background: var(--green-bg);
}

.device-name {
  font-weight: 600;
  color: var(--text);
}

.device-rssi {
  font-size: 26rpx;
  color: var(--text-dim);
  font-family: monospace;
}

/* ============== 传感器网格 ============== */
.sensor-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
}

.sensor-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
  background: var(--primary-light);
  border-radius: 16rpx;
}

.s-label {
  font-size: 24rpx;
  color: var(--text-dim);
  margin-bottom: 8rpx;
}

.s-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

/* ============== 版本信息 ============== */
.version-info {
  margin-top: 16rpx;
  text-align: center;
  color: var(--text-mute);
  font-size: 26rpx;
}

/* ============== OTA 相关 ============== */
.ota-card {
  border: 2rpx dashed var(--border-strong);
}

.ota-info {
  padding: 16rpx;
  background: var(--amber-bg);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--amber);
}

.fw-info {
  margin-top: 16rpx;
  padding: 16rpx;
  background: var(--green-bg);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--green);
}

.ota-progress {
  margin-top: 16rpx;
}

.progress-bar {
  width: 100%;
  height: 24rpx;
  background: var(--border);
  border-radius: 100rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: var(--primary);
  transition: width 0.3s ease;
}

.ota-progress text {
  font-size: 26rpx;
  color: var(--text-dim);
}

/* ============== 日志 ============== */
.clear-btn {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: normal;
}

.log-box {
  height: 400rpx;
  background: #1e293b;
  border-radius: 16rpx;
  padding: 20rpx;
  font-family: monospace;
  font-size: 24rpx;
  line-height: 1.6;
}

.log-line {
  word-break: break-all;
  white-space: pre-wrap;
}

.log-info { color: #94a3b8; }
.log-tx { color: #60a5fa; }
.log-rx { color: #fbbf24; }
.log-ok { color: #34d399; }
.log-err { color: #f87171; }
.log-warn { color: #fb923c; }
