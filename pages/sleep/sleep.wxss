/* pages/sleep/sleep.wxss — OV Watch 睡眠报告页 */

.container {
  padding: 24rpx 32rpx 120rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============== 空态/错误 ============== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
}

.empty-icon { font-size: 96rpx; }
.empty-text {
  font-size: 30rpx;
  color: var(--text);
  margin-top: 32rpx;
  text-align: center;
}
.empty-hint {
  font-size: 24rpx;
  color: var(--text-mute);
  margin-top: 12rpx;
  text-align: center;
}
.retry-btn {
  margin-top: 48rpx;
  padding: 18rpx 88rpx;
  background: var(--primary, #2563eb);
  color: #fff;
  font-size: 28rpx;
  border-radius: 44rpx;
}

/* ============== 有数据时的顶部提示横幅 ============== */
.banner-state {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(245, 158, 11, 0.12);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 28rpx;
}
.banner-text {
  font-size: 24rpx;
  color: #b45309;
  flex: 1;
}
.banner-retry {
  font-size: 24rpx;
  color: #b45309;
  padding: 8rpx 28rpx;
  border: 1rpx solid #b45309;
  border-radius: 30rpx;
  margin-left: 20rpx;
}

/* ============== 最近一晚卡片 ============== */
.night-card {
  background: var(--surface, #fff);
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow, 0 4rpx 16rpx rgba(0,0,0,0.06));
}

.night-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.night-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text, #111);
}

.score-badge {
  background: #ede9fe;
  border-radius: 24rpx;
  padding: 10rpx 24rpx;
  display: flex;
  align-items: baseline;
}
.score-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #7c3aed;
  font-variant-numeric: tabular-nums;
}
.score-unit {
  font-size: 22rpx;
  font-weight: 600;
  color: #7c3aed;
  margin-left: 4rpx;
}

.night-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.night-item {
  flex: 0 0 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.night-item-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text, #111);
  font-variant-numeric: tabular-nums;
}

.night-item-label {
  font-size: 22rpx;
  color: var(--text-mute, #999);
  margin-top: 8rpx;
}

/* ============== 时间轴卡片 ============== */
.timeline-card {
  background: var(--surface, #fff);
  border-radius: 32rpx;
  padding: 36rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow, 0 4rpx 16rpx rgba(0,0,0,0.06));
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text, #111);
}

.legend-wrap { display: flex; align-items: center; gap: 20rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; }
.legend-dot { width: 16rpx; height: 16rpx; border-radius: 4rpx; }
.legend-sleep { background: #7c3aed; }
.legend-wake { background: #f59e0b; }
.legend-text { font-size: 22rpx; color: var(--text-mute, #999); }

.timeline-bar {
  display: flex;
  height: 48rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.tl-seg { flex: 1; }
.tl-sleep { background: #7c3aed; }
.tl-wake { background: #f59e0b; }

.timeline-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
}
.tl-label {
  font-size: 22rpx;
  color: var(--text-mute, #999);
  font-variant-numeric: tabular-nums;
}

/* ============== 7天历史卡片 ============== */
.history-card {
  background: var(--surface, #fff);
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: var(--shadow, 0 4rpx 16rpx rgba(0,0,0,0.06));
}

.history-list {
  display: flex;
  flex-direction: column;
}

.history-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.history-row:last-child { border-bottom: none; }

.history-date {
  flex: 1;
  font-size: 26rpx;
  color: var(--text, #111);
}

.history-range {
  flex: 1.4;
  font-size: 24rpx;
  color: var(--text-mute, #999);
  font-variant-numeric: tabular-nums;
}

.history-dur {
  flex: 0.6;
  font-size: 26rpx;
  font-weight: 600;
  color: #7c3aed;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* ===================== 周统计 ===================== */
.week-stats {
  display: flex;
  background: #f5f3ff;
  border-radius: 20rpx;
  padding: 20rpx 0;
  margin-bottom: 24rpx;
}

.week-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.week-stat-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #6d28d9;
  font-variant-numeric: tabular-nums;
}

.week-stat-label {
  font-size: 20rpx;
  color: var(--text-mute, #999);
  margin-top: 6rpx;
}

/* ===================== 历史睡眠趋势折线图 ===================== */
.chart-card {
  background: var(--card, #fff);
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: var(--shadow, 0 4rpx 16rpx rgba(0,0,0,0.06));
}

.chart-sub {
  font-size: 22rpx;
  color: var(--text-mute, #999);
}

.chart-wrap {
  display: flex;
  align-items: stretch;
  margin-top: 24rpx;
}

.chart-yaxis {
  width: 56rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  padding: 0 8rpx 0 0;
}

.chart-ylabel {
  font-size: 20rpx;
  color: var(--text-mute, #999);
  line-height: 1;
}

.chart-plot {
  position: relative;
  width: 600rpx;
  height: 150rpx;
  overflow: visible;
}

.chart-grid {
  position: absolute;
  left: 0;
  width: 600rpx;
  height: 1rpx;
  background: #eef0f4;
}

.chart-line {
  position: absolute;
  height: 3rpx;
  background: linear-gradient(90deg, #a78bfa, #7c3aed);
  border-radius: 2rpx;
  transform-origin: left center;
}

.chart-dot {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  margin-left: -7rpx;
  margin-bottom: -7rpx;
  border-radius: 50%;
  background: #7c3aed;
  border: 3rpx solid #fff;
  box-shadow: 0 2rpx 6rpx rgba(124, 58, 237, 0.35);
}

.chart-dot-latest {
  width: 20rpx;
  height: 20rpx;
  margin-left: -10rpx;
  margin-bottom: -10rpx;
  background: #f59e0b;
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.45);
}

.chart-xlabels {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-left: 56rpx;
}

.chart-xlabel {
  font-size: 22rpx;
  color: var(--text-mute, #999);
}
