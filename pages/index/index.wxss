/* pages/index/index.wxss — OV Watch 仪表盘风格 */

/* ============== 通用 ============== */
.container {
  padding: 24rpx 32rpx 120rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============== 顶部状态栏 ============== */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 32rpx;
}

.status-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 100rpx;
  background: var(--surface);
  box-shadow: var(--shadow);
  font-size: 26rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.dot-green { background: var(--green); box-shadow: 0 0 10rpx var(--green); }
.dot-gray { background: var(--border-strong); }

.status-label {
  color: var(--text);
  font-weight: 500;
}

.status-arrow {
  color: var(--text-mute);
  font-weight: bold;
}

/* ============== 主概览卡片 ============== */
.hero-card {
  background: linear-gradient(145deg, #1e293b 0%, #334155 100%);
  color: #fff;
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 10rpx 40rpx rgba(30, 41, 59, 0.2);
  position: relative;
  overflow: hidden;
}

.hero-card::after {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(59, 130, 246, 0.15), transparent 70%);
  border-radius: 50%;
}

.hero-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.hero-date {
  font-size: 32rpx;
  font-weight: 600;
  opacity: 0.9;
}

.hero-sync {
  font-size: 24rpx;
  opacity: 0.7;
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(255,255,255,0.2);
  border-radius: 100rpx;
}

.hero-main {
  display: flex;
  align-items: center;
  gap: 40rpx;
  position: relative;
  z-index: 2;
}

/* 圆环 */
.hero-ring-wrap {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
}

.hero-ring-bg {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 8rpx solid rgba(255,255,255,0.1);
}

.hero-ring-progress {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: conic-gradient(var(--primary) calc(var(--progress) * 1%), transparent 0);
  -webkit-mask: radial-gradient(transparent 62%, #000 63%);
  mask: radial-gradient(transparent 62%, #000 63%);
}

.hero-ring-center {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.hero-ring-percent {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.hero-ring-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 4rpx;
}

/* 核心信息 */
.hero-info {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 16rpx;
}

.hero-info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.hero-info-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
  font-variant-numeric: tabular-nums;
}

.hero-info-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.6);
}

.hero-info-divider {
  width: 1rpx;
  height: 50rpx;
  background: rgba(255,255,255,0.2);
}

/* ============== 功能卡片网格 ============== */
.feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.feature-card {
  background: var(--surface);
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  box-shadow: var(--shadow);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  transition: transform 0.2s ease;
  position: relative;
  overflow: hidden;
}

.feature-card:active {
  transform: scale(0.97);
}

.feature-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.feature-icon {
  font-size: 48rpx;
}

.feature-icon-red { background: #fee2e2; color: #dc2626; }
.feature-icon-blue { background: #dbeafe; color: #2563eb; }
.feature-icon-green { background: #dcfce7; color: #16a34a; }
.feature-icon-purple { background: #ede9fe; color: #7c3aed; }
.feature-icon-orange { background: #ffedd5; color: #ea580c; }
.feature-icon-cyan { background: #cffafe; color: #0891b2; }

.feature-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.feature-title {
  font-size: 26rpx;
  color: var(--text-mute);
  font-weight: 500;
}

.feature-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

.feature-unit {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-dim);
  margin-left: 4rpx;
}

.feature-arrow {
  position: absolute;
  top: 32rpx;
  right: 28rpx;
  font-size: 28rpx;
  color: var(--text-mute);
}

/* ============== 底部 ============== */
.footer {
  text-align: center;
  padding: 32rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: var(--text-mute);
}
