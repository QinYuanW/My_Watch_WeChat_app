<!--pages/index/index.wxml — OV Watch 仪表盘风格 -->
<view class="container">

  <!-- ═══════════ 顶部连接状态 ═══════════ -->
  <view class="status-bar">
    <view class="status-item" bindtap="onTapConnection">
      <view class="status-dot {{connected ? 'dot-green' : 'dot-gray'}}"></view>
      <text class="status-label">{{connected ? '已连接' : '未连接'}}</text>
      <text class="status-arrow">›</text>
    </view>
  </view>

  <!-- ═══════════ 主概览卡片 (Hero Card) ═══════════ -->
  <view class="card hero-card" bindtap="onTapOverview">
    <view class="hero-header">
      <text class="hero-date">{{currentDate}}</text>
      <text class="hero-sync" bindtap="onTapSyncTime" catchtap="onTapSyncTime">⏱ 同步</text>
    </view>
    <view class="hero-main">
      <view class="hero-ring-wrap">
        <view class="hero-ring-bg"></view>
        <view class="hero-ring-progress" style="--progress: {{overviewProgress}};"></view>
        <view class="hero-ring-center">
          <text class="hero-ring-percent">{{overviewProgress}}%</text>
          <text class="hero-ring-label">今日进度</text>
        </view>
      </view>
      <view class="hero-info">
        <view class="hero-info-item">
          <text class="hero-info-value">{{sensor.steps || '--'}}</text>
          <text class="hero-info-label">步数</text>
        </view>
        <view class="hero-info-divider"></view>
        <view class="hero-info-item">
          <text class="hero-info-value">{{sensor.heartRate || '--'}}</text>
          <text class="hero-info-label">心率</text>
        </view>
        <view class="hero-info-divider"></view>
        <view class="hero-info-item">
          <text class="hero-info-value">{{sensor.spo2 || '--'}}%</text>
          <text class="hero-info-label">血氧</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ═══════════ 功能卡片区 (Grid) ═══════════ -->
  <view class="feature-grid">

    <!-- 心率卡片 -->
    <view class="feature-card" bindtap="onTapFeature" data-feature="heartRate">
      <view class="feature-icon-wrap feature-icon-red">
        <text class="feature-icon">❤️</text>
      </view>
      <view class="feature-info">
        <text class="feature-title">心率</text>
        <text class="feature-value">{{sensor.heartRate || '--'}}<text class="feature-unit">BPM</text></text>
      </view>
      <view class="feature-arrow">›</view>
    </view>

    <!-- 血氧卡片 -->
    <view class="feature-card" bindtap="onTapFeature" data-feature="spo2">
      <view class="feature-icon-wrap feature-icon-blue">
        <text class="feature-icon">🫁</text>
      </view>
      <view class="feature-info">
        <text class="feature-title">血氧</text>
        <text class="feature-value">{{sensor.spo2 || '--'}}<text class="feature-unit">%</text></text>
      </view>
      <view class="feature-arrow">›</view>
    </view>

    <!-- 步数卡片 -->
    <view class="feature-card" bindtap="onTapFeature" data-feature="steps">
      <view class="feature-icon-wrap feature-icon-green">
        <text class="feature-icon">👟</text>
      </view>
      <view class="feature-info">
        <text class="feature-title">步数</text>
        <text class="feature-value">{{sensor.steps || '--'}}<text class="feature-unit">步</text></text>
      </view>
      <view class="feature-arrow">›</view>
    </view>

    <!-- 睡眠卡片 (占位) -->
    <view class="feature-card" bindtap="onTapFeature" data-feature="sleep">
      <view class="feature-icon-wrap feature-icon-purple">
        <text class="feature-icon">😴</text>
      </view>
      <view class="feature-info">
        <text class="feature-title">睡眠</text>
        <text class="feature-value">{{sleepDuration || '--'}}<text class="feature-unit">小时</text></text>
      </view>
      <view class="feature-arrow">›</view>
    </view>

    <!-- 温度卡片 -->
    <view class="feature-card" bindtap="onTapFeature" data-feature="temperature">
      <view class="feature-icon-wrap feature-icon-orange">
        <text class="feature-icon">🌡️</text>
      </view>
      <view class="feature-info">
        <text class="feature-title">温度</text>
        <text class="feature-value">{{sensor.temperature || '--'}}<text class="feature-unit">°C</text></text>
      </view>
      <view class="feature-arrow">›</view>
    </view>

    <!-- 湿度卡片 -->
    <view class="feature-card" bindtap="onTapFeature" data-feature="humidity">
      <view class="feature-icon-wrap feature-icon-cyan">
        <text class="feature-icon">💧</text>
      </view>
      <view class="feature-info">
        <text class="feature-title">湿度</text>
        <text class="feature-value">{{sensor.humidity || '--'}}<text class="feature-unit">%</text></text>
      </view>
      <view class="feature-arrow">›</view>
    </view>

  </view>

  <!-- 底部提示 -->
  <view class="footer">
    <text class="footer-text">数据来自 {{connected ? '当前手表' : '最近记录'}}</text>
  </view>

</view>
